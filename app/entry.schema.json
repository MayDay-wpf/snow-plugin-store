{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MayDay-wpf/snow-plugin-store/app/entry.schema.json",
  "title": "Snow App plugin market entry (app/plugins/<id>.json)",
  "type": "object",
  "required": ["id", "name", "description", "repo", "version", "sha256"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,95}$"
    },
    "kind": { "type": "string", "enum": ["plugin", "oauth", "tool", "script"] },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "author": { "type": "string" },
    "homepage": { "type": "string" },
    "repo": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+$"
    },
    "version": { "type": "string", "minLength": 1 },
    "tag": { "type": "string" },
    "asset": { "type": "string" },
    "downloadUrl": { "type": "string", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "minAppVersion": { "type": "string" },
    "privacy": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "icon": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "minProperties": 1
        }
      ]
    }
  }
}
